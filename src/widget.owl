widget "wallswap" {
  page: 2
  order: 5
  size: 3x3
  minSize: 2x2
  meta { owl: 13; description: "Keeps the wallpaper fresh: a new image from NASA APOD, Bing, Wikimedia Commons or Wallhaven every hour, cropped to the phone, with a preview, credits, previous and keep"; version: "1.0.0"; license: "MIT"; category: "media" }

  requires { pacman: ["curl", "jq", "file", "imagemagick"] }

  // The whole wallswap script, run with bash -c: wallswap.sh in https://github.com/petrzpav/omalauncher-wallswap,
  // spliced in by build.sh. It fetches, crops the image to the screen into
  // ~/.config/omarchy/backgrounds/<theme>/ and points style.toml's background at it.
  let ws = """
@WALLSWAP_SH@"""

  // Settings, set from the screen; the script gets them as one JSON argument.
  state sources = ["apod", "bing", "wikimedia", "wallhaven"] persist
  state interval = 60 persist
  state query = "" persist

  source sys = android.system every 10m
  source now = clock every 30s
  let cfg = toJson({sources: sources, interval: interval, query: query, screen: sys == null ? null : [sys.display.width, sys.display.height], theme: sys == null ? null : sys.theme})
  source st = cmd("bash -c ${sh(ws)} wallswap info ${sh(cfg)}") every 1m json

  // The schedule: `at` runs even while the page is off screen, and a time missed while the launcher
  // was closed runs at its next start. The script decides whether a swap is due and when the next is.
  state nextAt = 0 persist
  state busy = false
  state out = ""
  at nextAt {
    nextAt = 0
    if !busy {
      busy = true
      out = run("bash -c ${sh(ws)} wallswap tick ${sh(cfg)} 2>&1 | tail -1; date +%s%N")
    }
  }
  // The date makes every run's output differ, so this fires each time one finishes.
  on out { busy = false }
  on st first { if !busy { nextAt = value.nextAt ?? 0 } }

  let hasImg = st != null && st.bg != null
  let err = st == null ? "" : st.error ?? ""
  let paused = st != null && st.paused == true
  let intervals = [15, 30, 60, 180, 360, 1440, 0]
  let everyLabel = interval <= 0 ? "only when you ask" : interval % 1440 == 0 ? "once a day" : interval % 60 == 0 ? (interval == 60 ? "every hour" : "every ${interval / 60} hours") : "every ${interval} minutes"
  let statusText = busy ? "fetching a new wallpaper…" : err != "" ? err : paused ? "paused" : interval <= 0 ? "swaps only when you ask" : st == null || now == null || st.nextAt <= 0 ? "" : st.nextAt <= now ? "swapping soon" : "next swap ${fmtAgo(st.nextAt, now)}"
  let allSources = [
    {id: "apod", label: "NASA APOD", detail: "Astronomy Picture of the Day"},
    {id: "bing", label: "Bing", detail: "Image of the day, in the phone's size"},
    {id: "wikimedia", label: "Wikimedia Commons", detail: "Picture of the day"},
    {id: "wallhaven", label: "Wallhaven", detail: query != "" ? "Top wallpapers matching “${query}”" : "Top wallpapers of the year"},
    {id: "local", label: "Local folder", detail: "~/Pictures/Wallpapers"}
  ]

  // While a swap runs the glyph turns: every second it gets another full turn to ease towards.
  state spin = 0
  every 1s { if busy { spin = spin + 360 } }

  padding: 0
  onTap: screen()

  component Action(glyph, label, active = true) {
    Column {
      gap: 4
      align: center
      opacity: active ? 1 : 0.35
      Box { width: 44; height: 44; radius: 22; align: center; background: alpha(accent, 0.16)
        Text { text: glyph; fontSize: 20; color: accent; align: center }
      }
      Text { text: label; style: small; color: muted; align: center; maxLines: 1 }
    }
  }

  Box {
    fill: true
    clip: true
    if hasImg {
      Image { src: st.bg; fit: cover; fill: true; label: st.title }
    } else {
      Box { fill: true; align: center; background: alpha(surface, 0.5)
        Text { text: "󰸉"; fontSize: 40; color: muted; align: center }
      }
    }
    Column {
      fill: true
      gap: 0
      Spacer { weight: 1 }
      Row {
        gap: 8
        align: bottom
        padding: [10, 18, 8, 8]
        background: linear(0, 0, 0, 1, [alpha(background, 0), alpha(background, 0.75), alpha(background, 0.92)])
        Column {
          gap: 1
          weight: 1
          Text { text: hasImg ? st.title : "no wallpaper yet"; fontSize: 12; fontWeight: 600; maxLines: 2 }
          Text { text: statusText != "" ? statusText : hasImg ? st.credit : ""; fontSize: 9; color: err != "" && !busy ? red : muted; maxLines: 1 }
        }
        // Next right from the tile.
        Box {
          width: 32
          height: 32
          radius: 16
          align: center
          background: alpha(accent, 0.22)
          onTap: { if !busy { haptic(); busy = true; nextAt = 0; out = run("bash -c ${sh(ws)} wallswap next ${sh(cfg)} 2>&1 | tail -1; date +%s%N") } }
          Text { text: "↻"; fontSize: 16; bold: true; color: accent; align: center; rotation: busy ? spin : 0; animate rotation: tween(1000ms, "linear") }
        }
      }
    }
  }

  screen {
    title: "wallswap"
    Column {
      scroll: true
      gap: 14
      Box {
        fill: width
        height: min(420, (screenHeight ?? 800) * 0.5)
        align: center
        if hasImg {
          Box { radius: 10 * corners; clip: true; onTap: { if st.page != "" { url(st.page) } }
            Image { src: st.bg; fit: contain; height: min(420, (screenHeight ?? 800) * 0.5); opacity: busy ? 0.5 : 1; animate opacity: tween(200ms, "ease") }
          }
        } else {
          Text { text: busy ? "fetching…" : "no wallpaper yet: tap next"; color: muted; align: center }
        }
      }
      if hasImg {
        Column {
          gap: 2
          Text { text: st.title; style: title; maxLines: 3 }
          Text { text: st.credit; color: muted; maxLines: 2 }
          Text { text: "${st.size} · ${st.sourceName}"; style: small; color: muted }
        }
      }
      Text { text: statusText; color: err != "" && !busy ? red : muted; visible: statusText != "" }
      if st != null && st.shown == false && hasImg {
        Text { text: "Another background is set in the Style menu; wallswap takes over at the next swap."; style: small; color: muted }
      }
      Row {
        justify: spaceEvenly
        Box { weight: 1; onTap: { if !busy { haptic(); busy = true; nextAt = 0; out = run("bash -c ${sh(ws)} wallswap next ${sh(cfg)} 2>&1 | tail -1; date +%s%N") } }
          Action { glyph: "↻"; label: "next"; active: !busy }
        }
        Box { weight: 1; onTap: { if !busy && st.hasPrevious == true { haptic(); busy = true; out = run("bash -c ${sh(ws)} wallswap prev ${sh(cfg)} 2>&1 | tail -1; date +%s%N") } }
          Action { glyph: "↺"; label: "previous"; active: !busy && st != null && st.hasPrevious == true }
        }
        Box { weight: 1; onTap: { if hasImg && st.page != "" { url(st.page) } }
          Action { glyph: "↗"; label: "source"; active: hasImg && st.page != "" }
        }
        Box { weight: 1; onTap: { if hasImg { haptic(); run("bash -c ${sh(ws)} wallswap keep ${sh(cfg)}"); notify("wallswap", "Kept in the theme's backgrounds") } }
          Action { glyph: "⤓"; label: "keep"; active: hasImg }
        }
      }
      Row {
        gap: 12
        align: center
        padding: [0, 4]
        onTap: { if interval > 0 { haptic(); run("bash -c ${sh(ws)} wallswap toggle ${sh(cfg)}") } }
        Column {
          gap: 0
          weight: 1
          Text { text: "Automatic swapping" }
          Text { text: interval <= 0 ? "off: swaps only when you ask" : paused ? "paused" : everyLabel; style: small; color: muted }
        }
        Box { width: 44; height: 24; radius: 12; padding: 3; background: !paused && interval > 0 ? accent : alpha(muted, 0.35); align: !paused && interval > 0 ? "end" : "start"
          Box { width: 18; height: 18; radius: 9; background: background }
        }
      }
      Column {
        gap: 2
        Text { text: "SOURCES"; fontSize: 10; letterSpacing: 2; color: muted }
        for s in allSources key s.id {
          let picked = sources.indexOf(s.id) >= 0
          Row {
            gap: 12
            align: center
            padding: [4, 8]
            // At least one source stays on.
            onTap: { haptic(); if picked { if len(sources) > 1 { sources = sources.filter(x => x != s.id) } } else { sources = flatten([sources, [s.id]]) } }
            Text { text: picked ? "■" : "□"; color: picked ? accent : muted; fontSize: 16 }
            Column {
              gap: 0
              weight: 1
              Text { text: s.label; color: picked ? foreground : muted }
              Text { text: s.detail; style: small; color: muted; maxLines: 1 }
            }
          }
        }
        Row {
          gap: 12
          align: center
          padding: [4, 8]
          onTap: { haptic(); interval = intervals[(intervals.indexOf(interval) + 1) % len(intervals)] }
          Text { text: "◷"; color: accent; fontSize: 16 }
          Column {
            gap: 0
            weight: 1
            Text { text: "Swap ${everyLabel}" }
            Text { text: "tap to change: 15 min … once a day … only when you ask"; style: small; color: muted; maxLines: 1 }
          }
        }
      }
      Column {
        gap: 2
        Text { text: "WALLHAVEN SEARCH"; fontSize: 10; letterSpacing: 2; color: muted }
        Input { text: query; placeholder: "e.g. space, mountains, city night"; onSubmit: query = trim(value) }
      }
      Text { text: "Images keep their original licenses; tap the picture for its source page. A port of omarchy-wallswap."; style: small; color: muted }
    }
  }
}
