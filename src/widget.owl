widget "wallswap" {
  page: 2
  order: 5
  size: 3x3
  minSize: 1x1
  meta { owl: 13; description: "Keeps the wallpaper fresh: a new image from NASA APOD, Bing, Wikimedia Commons, Wallhaven or a folder of your own, in the phone or in Linux, once a day, cropped to the phone, with a preview, credits, previous and keep"; version: "1.5.0"; license: "MIT"; category: "media" }

  requires { pacman: ["curl", "jq", "file", "imagemagick", "libjpeg-turbo", "libwebp", "iproute2"] }

  // The whole wallswap script, run with bash -c: wallswap.sh in https://github.com/petrzpav/omalauncher-wallswap,
  // spliced in by build.sh. It fetches, crops the image to the screen into
  // ~/.config/omarchy/backgrounds/<theme>/ and points style.toml's background at it.
  let ws = """
@WALLSWAP_SH@"""

  // Settings, set from the screen; the script gets them as one JSON argument.
  state sources = ["apod", "bing", "wikimedia", "wallhaven"] persist
  state interval = 1440 persist
  state query = "" persist
  state localDir = "~/Pictures/Wallpapers" persist
  state phoneDir = "Pictures/Wallpapers" persist
  state wifiOnly = true persist
  state notAsleep = true persist

  source sys = android.system every 10m
  source now = clock every 30s
  // Bedtime mode turns on Do Not Disturb: while it's on, automatic swaps wait.
  source modes = android.modes
  let asleep = notAsleep && modes != null && modes.dnd == true
  let cfg = toJson({sources: sources, interval: interval, query: query, localDir: localDir, phoneDir: phoneDir, wifiOnly: wifiOnly, screen: sys == null ? null : [sys.display.width, sys.display.height], theme: sys == null ? null : sys.theme})
  source st = cmd("bash -c ${sh(ws)} wallswap info ${sh(cfg)}") every 1m json

  // The schedule: `at` runs even while the page is off screen, and a time missed while the launcher
  // was closed runs at its next start. The script decides whether a swap is due and when the next is.
  state nextAt = 0 persist
  state busy = false
  state out = ""
  at nextAt {
    nextAt = 0
    if !busy && !asleep {
      busy = true
      out = run("bash -c ${sh(ws)} wallswap tick ${sh(cfg)} 2>&1 | tail -1; date +%s%N")
    }
  }
  // The date makes every run's output differ, so this fires each time one finishes.
  on out { busy = false }
  on st first { if !busy { nextAt = value.nextAt ?? 0 } }
  // A swap that came due while asleep runs on waking; tick does nothing when none is due.
  on asleep { if !value && !busy {
    busy = true
    out = run("bash -c ${sh(ws)} wallswap tick ${sh(cfg)} 2>&1 | tail -1; date +%s%N")
  } }

  let hasImg = st != null && st.bg != null
  // A one-column tile stacks the caption over the next button; a one-row tile puts them in a line.
  let narrow = (tileWidth ?? 999) < 100
  let short = (tileHeight ?? 999) < 100
  let err = st == null ? "" : st.error ?? ""
  let paused = st != null && st.paused == true
  let waitingWifi = st != null && st.waitingWifi == true
  let intervals = [15, 30, 60, 180, 360, 1440, 0]
  let everyLabel = interval <= 0 ? "only when you ask" : interval % 1440 == 0 ? "once a day" : interval % 60 == 0 ? (interval == 60 ? "every hour" : "every ${interval / 60} hours") : "every ${interval} minutes"
  let statusText = busy ? "fetching a new wallpaper…" : err != "" ? err : paused ? "paused" : interval <= 0 ? "swaps only when you ask" : waitingWifi ? "waiting for Wi-Fi" : asleep && st != null && now != null && st.nextAt > 0 && st.nextAt <= now ? "waiting until Do Not Disturb is off" : st == null || now == null || st.nextAt <= 0 ? "" : st.nextAt <= now ? "swapping soon" : "next swap ${fmtAgo(st.nextAt, now)}"
  let allSources = [
    {id: "apod", label: "NASA APOD", detail: "Astronomy Picture of the Day"},
    {id: "bing", label: "Bing", detail: "Image of the day, in the phone's size"},
    {id: "wikimedia", label: "Wikimedia Commons", detail: "Picture of the day"},
    {id: "wallhaven", label: "Wallhaven", detail: query != "" ? "Top wallpapers matching “${query}”" : "Top wallpapers of the year"},
    {id: "phone", label: "Phone folder", detail: "Each image in turn from ${phoneDir}"},
    {id: "local", label: "Linux folder", detail: "Each image in turn from ${localDir}"}
  ]
  // Picking a folder, for the phone or the Linux folder source: which one is open, and what's in it.
  state browsing = ""
  state browseOut = ""
  let br = browseOut == "" ? null : parseJson(browseOut)

  // The tile has the same glass as home's other tiles, with the caption on it.
  padding: 0
  onTap: screen()

  // Arrows drawn as lines, so they sit in the middle of their circles whatever the font: a right
  // arrow turned by `turn` degrees, and for keep a down arrow onto a line.
  component Glyph(turn = 0, base = false, tint = accent, s = 18) {
    Canvas {
      width: s
      height: s
      translate(0, base ? -s * 0.1 : 0) {
        rotate(turn, s / 2, s / 2) {
          line(s * 0.16, s / 2, s * 0.82, s / 2, stroke: tint, width: s * 0.11, cap: round)
          path([[s * 0.54, s * 0.22], [s * 0.82, s / 2], [s * 0.54, s * 0.78]], stroke: tint, width: s * 0.11, cap: round)
        }
      }
      if base {
        line(s * 0.2, s * 0.9, s * 0.8, s * 0.9, stroke: tint, width: s * 0.11, cap: round)
      }
    }
  }

  // A folder, drawn: the font has no folder glyph.
  component FolderGlyph(tint = accent, s = 16) {
    Canvas {
      width: s
      height: s
      rect(s * 0.06, s * 0.16, s * 0.4, s * 0.24, fill: tint, radius: s * 0.06)
      rect(s * 0.06, s * 0.28, s * 0.88, s * 0.58, fill: tint, radius: s * 0.08)
    }
  }

  component Action(label, turn = 0, base = false, active = true) {
    Column {
      gap: 4
      align: center
      opacity: active ? 1 : 0.35
      Box { width: 44; height: 44; radius: 22; align: center; background: alpha(accent, 0.16)
        Glyph { turn: turn; base: base; s: 20 }
      }
      Text { text: label; style: small; color: muted; align: center; maxLines: 1 }
    }
  }

  Box {
    fill: true
    clip: true
    if !hasImg {
      Box { fill: true; align: center
        Text { text: "󰸉"; fontSize: 40; color: muted; align: center; visible: !short }
      }
    }
    if short && narrow {
      // One cell: only the next button.
      Box { fill: true; align: center
        Box { width: 36; height: 36; radius: 18; align: center; background: alpha(accent, 0.22); opacity: busy ? 0.4 : 1
          onTap: { if !busy { haptic(); busy = true; nextAt = 0; out = run("bash -c ${sh(ws)} wallswap next ${sh(cfg)} 2>&1 | tail -1; date +%s%N") } }
          Glyph { s: 18 }
        }
      }
    } else if short {
      // One row high: the caption and the next button in a line.
      Row {
        fill: true
        gap: 8
        align: center
        padding: [10, 6, 8, 6]
        Column {
          gap: 1
          weight: 1
          Text { text: hasImg ? st.title : "no wallpaper yet"; fontSize: 12; fontWeight: 600; maxLines: 1 }
          Text { text: statusText != "" ? statusText : hasImg ? st.credit : ""; fontSize: 9; color: err != "" && !busy ? red : muted; maxLines: 1 }
        }
        Box { width: 32; height: 32; radius: 16; align: center; background: alpha(accent, 0.22); opacity: busy ? 0.4 : 1
          onTap: { if !busy { haptic(); busy = true; nextAt = 0; out = run("bash -c ${sh(ws)} wallswap next ${sh(cfg)} 2>&1 | tail -1; date +%s%N") } }
          Glyph { s: 16 }
        }
      }
    } else {
      Column {
        fill: true
        gap: 0
        Spacer { weight: 1 }
        if narrow {
          // One column wide: the caption over the next button, both at the bottom.
          Column {
            gap: 6
            padding: [7, 18, 7, 8]
            Column {
              gap: 1
              Text { text: hasImg ? st.title : "no wallpaper yet"; fontSize: 11; fontWeight: 600; maxLines: (tileHeight ?? 0) > 160 ? 3 : 2 }
              Text { text: statusText != "" ? statusText : hasImg ? st.credit : ""; fontSize: 9; color: err != "" && !busy ? red : muted; maxLines: 2 }
            }
            Box { width: 32; height: 32; radius: 16; align: center; background: alpha(accent, 0.22); opacity: busy ? 0.4 : 1
              onTap: { if !busy { haptic(); busy = true; nextAt = 0; out = run("bash -c ${sh(ws)} wallswap next ${sh(cfg)} 2>&1 | tail -1; date +%s%N") } }
              Glyph { s: 16 }
            }
          }
        } else {
          Row {
            gap: 8
            align: bottom
            padding: [10, 18, 8, 8]
            Column {
              gap: 1
              weight: 1
              Text { text: hasImg ? st.title : "no wallpaper yet"; fontSize: 12; fontWeight: 600; maxLines: 2 }
              Text { text: statusText != "" ? statusText : hasImg ? st.credit : ""; fontSize: 9; color: err != "" && !busy ? red : muted; maxLines: 1 }
            }
            // Next right from the tile.
            Box {
              width: 32
              height: 32
              radius: 16
              align: center
              background: alpha(accent, 0.22)
              opacity: busy ? 0.4 : 1
              onTap: { if !busy { haptic(); busy = true; nextAt = 0; out = run("bash -c ${sh(ws)} wallswap next ${sh(cfg)} 2>&1 | tail -1; date +%s%N") } }
              Glyph { s: 16 }
            }
          }
        }
      }
    }
  }

  screen {
    title: "wallswap"
    Column {
      scroll: true
      gap: 14
      Box {
        fill: width
        height: min(420, (screenHeight ?? 800) * 0.5)
        align: center
        if hasImg {
          Box { radius: 10 * corners; clip: true; onTap: { if st.page != "" { url(st.page) } }
            Image { src: st.bg; fit: contain; height: min(420, (screenHeight ?? 800) * 0.5); opacity: busy ? 0.5 : 1; animate opacity: tween(200ms, "ease") }
          }
        } else {
          Text { text: busy ? "fetching…" : "no wallpaper yet: tap next"; color: muted; align: center }
        }
      }
      if hasImg {
        Column {
          gap: 2
          Text { text: st.title; style: title; maxLines: 3 }
          Text { text: st.credit; color: muted; maxLines: 2 }
          Text { text: "${st.size} · ${st.sourceName}"; style: small; color: muted }
        }
      }
      Text { text: statusText; color: err != "" && !busy ? red : muted; visible: statusText != "" }
      if st != null && st.shown == false && hasImg {
        Text { text: "Another background is set in the Style menu; wallswap takes over at the next swap."; style: small; color: muted }
      }
      Row {
        justify: spaceEvenly
        Box { weight: 1; onTap: { if !busy { haptic(); busy = true; nextAt = 0; out = run("bash -c ${sh(ws)} wallswap next ${sh(cfg)} 2>&1 | tail -1; date +%s%N") } }
          Action { label: "next"; active: !busy }
        }
        Box { weight: 1; onTap: { if !busy && st.hasPrevious == true { haptic(); busy = true; out = run("bash -c ${sh(ws)} wallswap prev ${sh(cfg)} 2>&1 | tail -1; date +%s%N") } }
          Action { label: "previous"; turn: 180; active: !busy && st != null && st.hasPrevious == true }
        }
        Box { weight: 1; onTap: { if hasImg && st.page != "" { url(st.page) } }
          Action { label: "source"; turn: -45; active: hasImg && st.page != "" }
        }
        Box { weight: 1; onTap: { if hasImg { haptic(); run("bash -c ${sh(ws)} wallswap keep ${sh(cfg)}"); notify("wallswap", "Kept in the theme's backgrounds") } }
          Action { label: "keep"; turn: 90; base: true; active: hasImg }
        }
      }
      Row {
        gap: 12
        align: center
        padding: [0, 4]
        onTap: { if interval > 0 { haptic(); run("bash -c ${sh(ws)} wallswap toggle ${sh(cfg)}") } }
        Column {
          gap: 0
          weight: 1
          Text { text: "Automatic swapping" }
          Text { text: interval <= 0 ? "off: swaps only when you ask" : paused ? "paused" : everyLabel; style: small; color: muted }
        }
        Box { width: 44; height: 24; radius: 12; padding: 3; background: !paused && interval > 0 ? accent : alpha(muted, 0.35); align: !paused && interval > 0 ? "end" : "start"
          Box { width: 18; height: 18; radius: 9; background: background }
        }
      }
      Row {
        gap: 12
        align: center
        padding: [0, 4]
        onTap: { haptic(); wifiOnly = !wifiOnly }
        Column {
          gap: 0
          weight: 1
          Text { text: "Only on Wi-Fi" }
          Text { text: wifiOnly ? "automatic swaps wait for Wi-Fi; next always swaps" : "on mobile data too"; style: small; color: muted }
        }
        Box { width: 44; height: 24; radius: 12; padding: 3; background: wifiOnly ? accent : alpha(muted, 0.35); align: wifiOnly ? "end" : "start"
          Box { width: 18; height: 18; radius: 9; background: background }
        }
      }
      Row {
        gap: 12
        align: center
        padding: [0, 4]
        onTap: { haptic(); notAsleep = !notAsleep }
        Column {
          gap: 0
          weight: 1
          Text { text: "Not while sleeping" }
          Text { text: notAsleep ? "automatic swaps wait during Do Not Disturb" : "also during Do Not Disturb"; style: small; color: muted }
        }
        Box { width: 44; height: 24; radius: 12; padding: 3; background: notAsleep ? accent : alpha(muted, 0.35); align: notAsleep ? "end" : "start"
          Box { width: 18; height: 18; radius: 9; background: background }
        }
      }
      Column {
        gap: 2
        Text { text: "SOURCES"; fontSize: 10; letterSpacing: 2; color: muted }
        for s in allSources key s.id {
          let picked = sources.indexOf(s.id) >= 0
          let isFolder = s.id == "phone" || s.id == "local"
          let folder = s.id == "phone" ? phoneDir : localDir
          Row {
            gap: 12
            align: center
            padding: [4, 8]
            // At least one source stays on.
            onTap: { haptic(); if picked { if len(sources) > 1 { sources = sources.filter(x => x != s.id) } } else { sources = flatten([sources, [s.id]]) } }
            Text { text: picked ? "■" : "□"; color: picked ? accent : muted; fontSize: 16 }
            Column {
              gap: 0
              weight: 1
              Text { text: s.label; color: picked ? foreground : muted }
              Text { text: s.detail; style: small; color: muted; maxLines: 1 }
            }
            // The folder picker, opened below the row.
            if isFolder {
              Box {
                width: 36
                height: 36
                radius: 18
                align: center
                background: alpha(accent, browsing == s.id ? 0.24 : 0.12)
                onTap: { haptic(); if browsing == s.id { browsing = "" } else { browsing = s.id; browseOut = ""; browseOut = run("bash -c ${sh(ws)} wallswap browse ${sh(cfg)} ${sh(s.id)} ${sh(folder)}") } }
                FolderGlyph { s: 16 }
              }
            }
          }
          // The search, only while Wallhaven is on.
          if s.id == "wallhaven" && picked {
            Box {
              padding: [36, 0, 8, 6]
              Input { text: query; placeholder: "search, e.g. space, mountains, city night"; onSubmit: query = trim(value) }
            }
          }
          if isFolder && browsing == s.id && br != null {
            Box {
              padding: [28, 0, 0, 6]
              Column {
                gap: 0
                padding: [4, 6, 4, 6]
                radius: 8 * corners
                background: alpha(accent, 0.06)
                Text { text: br.path == "" ? "Folders the launcher may reach" : br.path; style: small; color: muted; padding: [8, 4]; maxLines: 2 }
                if br.parent != null {
                  Row {
                    gap: 12
                    align: center
                    padding: [4, 8]
                    onTap: { haptic(); browseOut = run("bash -c ${sh(ws)} wallswap browse ${sh(cfg)} ${sh(s.id)} ${sh(br.parent)}") }
                    Glyph { turn: -90; s: 16 }
                    Text { text: br.parent == "" ? "all folders" : br.parent; color: muted; weight: 1; maxLines: 1 }
                  }
                }
                for d in br.dirs key d.path {
                  Row {
                    gap: 12
                    align: center
                    padding: [4, 8]
                    onTap: { haptic(); browseOut = run("bash -c ${sh(ws)} wallswap browse ${sh(cfg)} ${sh(s.id)} ${sh(d.path)}") }
                    FolderGlyph { s: 16 }
                    Text { text: d.name; weight: 1; maxLines: 1 }
                    Text { text: "›"; color: muted }
                  }
                }
                if br.error != null {
                  Text { text: br.error; style: small; color: red; padding: [8, 4] }
                }
                if br.path == "" {
                  Row {
                    gap: 12
                    align: center
                    padding: [4, 8]
                    onTap: { haptic(); launcher("settings") }
                    Text { text: "+"; color: accent; fontSize: 18; width: 16; align: center }
                    Text { text: "Another folder: allow it in the launcher's settings, under permissions"; style: small; color: muted; weight: 1 }
                  }
                } else {
                  Row {
                    gap: 12
                    align: center
                    padding: [8, 8]
                    Text { text: br.images > 0 ? "${br.images} images here" : "no images right here"; style: small; color: muted; weight: 1 }
                    Button { text: "use this folder"; onTap: { haptic(); if s.id == "phone" { phoneDir = br.path } else { localDir = br.path }; browsing = ""; if !picked { sources = flatten([sources, [s.id]]) } } }
                  }
                }
              }
            }
          }
        }
        Row {
          gap: 12
          align: center
          padding: [4, 8]
          onTap: { haptic(); interval = intervals[(intervals.indexOf(interval) + 1) % len(intervals)] }
          Text { text: "◷"; color: accent; fontSize: 16 }
          Column {
            gap: 0
            weight: 1
            Text { text: "Swap ${everyLabel}" }
            Text { text: "tap to change: 15 min … once a day … only when you ask"; style: small; color: muted; maxLines: 1 }
          }
        }
      }
      Text { text: "Images keep their original licenses; tap the picture for its source page. A port of omarchy-wallswap."; style: small; color: muted }
    }
  }
}
